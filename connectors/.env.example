# Copy to .env.local and fill in. .env.local is gitignored.
# Verify with:  npm run probe

# ---- ServiceNow -------------------------------------------------------------
# instance is the subdomain, e.g. dev12345, or a full https URL.
# Basic auth is fine for a PDI; use SERVICENOW_TOKEN (OAuth2) for anything real,
# because basic auth sends the password on every single request.
SERVICENOW_INSTANCE=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# SERVICENOW_TOKEN=

# ---- Confluence Cloud -------------------------------------------------------
# apiToken is an Atlassian API token, NOT the account password:
# https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_SITE=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# ---- SharePoint / OneDrive (Microsoft Graph) --------------------------------
# App registration with APPLICATION permissions and admin consent granted:
#   Sites.Read.All or Sites.ReadWrite.All, Files.Read.All or Files.ReadWrite.All
# Delegated permissions of the same name will authorise and then 403 every call.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_ACCESS_TOKEN=

# ---- Box --------------------------------------------------------------------
# A developer token from the Box console lasts one hour and is fine for testing.
BOX_ACCESS_TOKEN=

# ---- AWX / Ansible Automation Controller ------------------------------------
AWX_HOST=
AWX_TOKEN=
# AWX_USERNAME=
# AWX_PASSWORD=
# Set true only for a self-signed certificate. Disables TLS verification for
# the whole process, so never set it in production.
# AWX_INSECURE=false

# ---- Chef Infra Server ------------------------------------------------------
# CHEF_KEY is the PEM private key. In a .env file write it on one line with
# literal \n between the lines; the probe converts them back.
CHEF_SERVER_URL=
CHEF_ORG=
CHEF_CLIENT_NAME=
CHEF_KEY=
# CHEF_SIGNING_VERSION=1.3
