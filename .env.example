# Copy to .env.local for development. Never commit real values.

# Signing key for the admin session cookie. Must be >= 32 chars.
#   openssl rand -hex 32
SESSION_SECRET=

# Bearer token for the automation API (POST/PATCH/DELETE /api/posts).
# Leave blank to disable writes over HTTP entirely.
#   openssl rand -hex 24
API_TOKEN=

# SQLite file. In production this must be on a persistent volume.
DATABASE_PATH=.data/pulplabs.db

# Where uploaded cover images are written. Must be on the same persistent
# volume as the database in production.
UPLOAD_DIR=.data/uploads

# Absolute origin — used for canonical URLs, OG tags, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only read by scripts/seed.mjs, to create or rotate the admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Groq — powers the site assistant. Server-side only, never NEXT_PUBLIC_*.
# (Groq the inference provider, keys start gsk_. Not xAI's Grok.)
GROQ_API_KEY=
# Any OpenAI-compatible provider works; override all three to switch.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# gpt-oss is a reasoning model. 'low' keeps latency down for simple lookups.
LLM_REASONING_EFFORT=low

# --- Contact form notifications ------------------------------------------
# Where enquiries are emailed. Comma separated. Without this, submissions are
# still saved to the `enquiries` table — only the notification is skipped.
ENQUIRY_RECIPIENTS=akshaysdeekshith@gmail.com,akashrkashyap98@gmail.com

# Pick ONE transport.
# Resend (no npm dependency, needs a verified sender domain for a custom From):
RESEND_API_KEY=
ENQUIRY_FROM="PulpLabs <onboarding@resend.dev>"

# ...or SMTP, which additionally needs: npm i nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- WhatsApp CTA ---------------------------------------------------------
# Country code + number, digits only, no + or spaces. e.g. 447700900123
# LEAVE BLANK and every device goes to /contact instead — which is the safe
# default, because a wrong number routes real enquiries to a stranger.
NEXT_PUBLIC_WHATSAPP=
