# Copy to .env.local for development. Never commit real values.

# Signing key for the admin session cookie. Must be >= 32 chars.
#   openssl rand -hex 32
SESSION_SECRET=

# Bearer token for the automation API (POST/PATCH/DELETE /api/posts).
# Leave blank to disable writes over HTTP entirely.
#   openssl rand -hex 24
API_TOKEN=

# SQLite file. In production this must be on a persistent volume.
DATABASE_PATH=.data/pulplabs.db

# Where uploaded cover images are written. Must be on the same persistent
# volume as the database in production.
UPLOAD_DIR=.data/uploads

# Absolute origin — used for canonical URLs, OG tags, sitemap and RSS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only read by scripts/seed.mjs, to create or rotate the admin login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# xAI (Grok) — powers the site assistant. Server-side only.
XAI_API_KEY=
# Override if the default model name is wrong for your account
XAI_MODEL=grok-4-fast
